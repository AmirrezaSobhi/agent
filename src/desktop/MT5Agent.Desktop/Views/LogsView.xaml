<UserControl x:Class="MT5Agent.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MT5Agent.Desktop.Resources">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
            <DockPanel Margin="0,9,0,4"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" Content="{x:Static res:Strings.RefreshLogs}"/><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,16" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox SelectedValue="{Binding Severity, Mode=TwoWay}" SelectedValuePath="Tag" MinHeight="34" VerticalContentAlignment="Center"><ComboBoxItem Content="All severities" Tag="ALL"/><ComboBoxItem Content="Info" Tag="INFO"/><ComboBoxItem Content="Warning" Tag="WARNING"/><ComboBoxItem Content="Error" Tag="ERROR"/></ComboBox>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="10,0" VerticalContentAlignment="Center" MinHeight="34" AutomationProperties.Name="Search logs" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox Content="Auto refresh · 30s" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/></StackPanel>
            </Grid>
        </Border>
        <ListView Grid.Row="2" ItemsSource="{Binding FilteredEntries}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" KeyboardNavigation.TabNavigation="Local">
            <ListView.View><GridView>
                <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}"/>
                <GridViewColumn Header="Level" Width="82" DisplayMemberBinding="{Binding Severity}"/>
                <GridViewColumn Header="Source" Width="150" DisplayMemberBinding="{Binding Source}"/>
                <GridViewColumn Header="Event" Width="160" DisplayMemberBinding="{Binding Code}"/>
                <GridViewColumn Header="Message" Width="430" DisplayMemberBinding="{Binding Message}"/>
            </GridView></ListView.View>
            <ListView.Style><Style TargetType="ListView"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasEntries}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListView.Style>
        </ListView>
        <TextBlock Grid.Row="2" Text="{Binding Message}" VerticalAlignment="Top" Margin="12,16,0,0" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasEntries}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
