<Window x:Class="MT5Agent.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MT5Agent.Desktop.Resources"
        Title="MT5Agent" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="{DynamicResource ShellDockMargin}">
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,30">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentStrongBrush}" HorizontalAlignment="Left" Margin="0,0,0,13">
                        <TextBlock Text="M" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.AppName}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.AppSubtitle}" Style="{StaticResource BodyText}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,16,4,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="{x:Static res:Strings.LocalSetup}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{x:Static res:Strings.NotConnected}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Local">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavigationButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Route}" IsEnabled="{Binding IsAvailable}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding AvailabilityText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static res:Strings.LocalSetup}" Style="{StaticResource BodyText}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="28,18,28,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource ErrorPanelBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock Text="!" FontWeight="Bold" Foreground="White" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl Content="{Binding CurrentPage}" Margin="{DynamicResource ShellContentMargin}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
