<UserControl x:Class="MT5Agent.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MT5Agent.Desktop.Resources">
    <StackPanel>
        <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,9,0,5" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,24" />
        <Border Style="{StaticResource CardBorder}" MaxWidth="620" HorizontalAlignment="Left" Padding="22">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.BuildLabel}" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding Version}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,16" />
                <TextBlock Text="{Binding TechnologyLabel}" Style="{StaticResource BodyText}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
