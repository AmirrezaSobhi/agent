<UserControl x:Class="MT5Agent.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MT5Agent.Desktop.Resources">
    <StackPanel>
        <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{x:Static res:Strings.SettingsTitle}" Style="{StaticResource PageTitle}" Margin="0,9,0,5" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,24" />
        <Border Style="{StaticResource CardBorder}" MaxWidth="650" HorizontalAlignment="Left" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding SettingLabel}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ThemeLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,6,0,2" />
                    <TextBlock Text="{Binding SaveState}" Style="{StaticResource BodyText}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding ToggleThemeCommand}"
                        Content="{x:Static res:Strings.ThemeToggle}" AutomationProperties.Name="{x:Static res:Strings.ThemeAutomationName}" />
            </Grid>
        </Border>
        <TextBlock Text="{Binding ScopeDescription}" Style="{StaticResource BodyText}" Margin="0,16,0,0" MaxWidth="650" />
    </StackPanel>
</UserControl>
