<UserControl x:Class="MT5Agent.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MT5Agent.Desktop.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.EyebrowLocalClient}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
        <DockPanel Margin="0,9,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"
                    Content="{x:Static res:Strings.RefreshStatus}" AutomationProperties.Name="Check Agent status" />
            <TextBlock Text="{x:Static res:Strings.DashboardTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{x:Static res:Strings.DashboardDescription}" Style="{StaticResource BodyText}" Margin="0,0,0,24" />

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SurfaceAltBrush}">
                    <TextBlock Text="i" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.NotConnected}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <ProgressBar Width="72" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{x:Static res:Strings.Loading}" Style="{StaticResource BodyText}" Margin="10,0,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{x:Static res:Strings.CurrentStatus}" Style="{StaticResource EyebrowText}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="{DynamicResource StatusCardMargin}" MinHeight="142">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,8" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding InlineError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
