<UserControl x:Class="MT5Agent.Desktop.Views.UnavailableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MT5Agent.Desktop.Resources">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.EyebrowLocalClient}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,9,0,5" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,24" />
        <Border Style="{StaticResource CardBorder}" Padding="24" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.NotImplemented}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
