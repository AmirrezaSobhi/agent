<UserControl x:Class="MT5Agent.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MT5Agent.Desktop.Resources">
    <StackPanel>
        <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
        <DockPanel Margin="0,9,0,4"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Content="{x:Static res:Strings.RefreshDiagnostics}"/><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,18" TextWrapping="Wrap"/>
        <Border Style="{StaticResource CardBorder}" Padding="20" MaxWidth="800" HorizontalAlignment="Left">
            <StackPanel>
                <DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static res:Strings.LocalDiagnosticSnapshot}" FontSize="16" FontWeight="SemiBold"/><Button Content="Copy summary" Command="{Binding CopySummaryCommand}" Margin="14,0,0,0" Padding="10,4"/><TextBlock Text="{Binding CopyFeedback}" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ProgressBar DockPanel.Dock="Right" Width="72" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/></DockPanel>
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,12">
                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static res:Strings.LastManagementResponse}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding LastResponse}" Style="{StaticResource BodyText}" Margin="0,3,0,12"/>
                <TextBlock Text="{x:Static res:Strings.ConnectionDiagnostics}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding ConnectionError}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Text="{x:Static res:Strings.DiagnosticsPrivacy}" Style="{StaticResource BodyText}" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
