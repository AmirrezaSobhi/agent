<UserControl x:Class="MT5Agent.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,9,0,5" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,0,0,24" />
        <Border Style="{StaticResource CardBorder}" Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,7,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
